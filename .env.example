# Copy to .env and fill in.

DATABASE_URL="file:./dev.db"

# Public base URL — used to build magic-link and dashboard URLs.
APP_URL="http://localhost:3000"

# The one email address auto-added to the invite allowlist on startup.
OWNER_EMAIL="you@example.com"

# Session lifetime (days)
SESSION_TTL_DAYS="30"

# Duffel — https://duffel.com (free self-serve account).
# Token needs the 'air.offer_requests.create' permission (write access).
DUFFEL_API_KEY_TEST="duffel_test_xxx"
DUFFEL_API_KEY_LIVE="duffel_live_xxx"
DUFFEL_ENV="test"            # "test" | "live"
DUFFEL_MIN_INTERVAL_MS="1100"
DUFFEL_MOCK=""               # "1" to use deterministic fake prices

# Resend — https://resend.com (digest email + magic-link sign-in)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="FlightFinder <onboarding@resend.dev>"
EMAIL_MOCK=""                # "1" to log digest emails instead of sending

# Scan scheduler (scripts/cron.ts)
SCAN_CRON="0 */6 * * *"      # every 6 hours
