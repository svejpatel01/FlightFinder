# Copy to .env and fill in.

DATABASE_URL="file:./dev.db"

# Public base URL — used to build magic-link and dashboard URLs.
APP_URL="http://localhost:3000"

# The one email address auto-added to the invite allowlist on startup.
OWNER_EMAIL="you@example.com"

# Session lifetime (days)
SESSION_TTL_DAYS="30"

# Flight price search — via the vendored `fli` library (lib/fli/), which talks
# directly to Google Flights' own frontend API. No key or account needed.
FLIGHTS_MIN_INTERVAL_MS="1500"
FLIGHTS_MOCK=""               # "1" to use deterministic fake prices

# Resend — https://resend.com (digest email + magic-link sign-in)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Notiflyer <onboarding@resend.dev>"
EMAIL_MOCK=""                # "1" to log digest emails instead of sending

# Scan scheduler (scripts/cron.ts)
SCAN_CRON="0 */6 * * *"      # every 6 hours
