// FlightFinder — Prisma schema (SQLite)
//
// Multi-user, invite-only. Sign-in is passwordless (magic link emailed via
// Resend). SQLite has no enums/arrays, so short string constants and
// JSON-encoded strings are used; allowed values live in lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth / accounts ----------------------------------------------------

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastLoginAt      DateTime?

  // Watch preferences
  budgetUsd        Float    @default(0)
  weeksAhead       Int      @default(12) // max 26, enforced in app
  alertOnBudget    Boolean  @default(true)
  alertOnPriceDrop Boolean  @default(true)
  scanEnabled      Boolean  @default(true) // user can pause without losing config

  // SMS (Twilio)
  phone     String? // E.164, e.g. +14155551234
  smsOptIn  Boolean @default(false)

  origins         Origin[]
  destinations    WishlistDestination[]
  weekendPatterns WeekendPattern[]
  notifications   NotificationLog[]
  sessions        Session[]
}

// Allowlist. Signing in requires an unused (or already-claimed-by-you) invite
// for that email address. Seed one for OWNER_EMAIL on startup; add more with
// `npm run invite -- add someone@example.com`.
model Invite {
  id        String   @id @default(cuid())
  email     String   @unique
  invitedBy String?
  note      String?
  createdAt DateTime @default(now())
  claimedAt DateTime?
}

// Single-use magic-link token. `email` (not userId) because the user row may
// not exist yet on first sign-in.
model LoginToken {
  id         String   @id @default(cuid())
  email      String
  tokenHash  String   @unique // sha256 of the random token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of the cookie value
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- Watch configuration ----------------------------------------------------

model Origin {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  iataCode String

  @@unique([userId, iataCode])
}

model WishlistDestination {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // kind = "AIRPORT" -> single airport/metro in `iataCode`
  // kind = "COUNTRY" -> ISO-3166 alpha-2 in `countryCode`, expanded + cached
  kind        String
  iataCode    String?
  countryCode String?
  label       String?

  resolvedAirports String? // JSON string[] of IATA codes, cached
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
}

model WeekendPattern {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern String // "FRI_SUN" | "SAT_SUN" | "THU_SUN"

  @@unique([userId, pattern])
}

// --- Price history + notifications ----------------------------------------

// Shared across users on purpose: the rolling average is per
// (origin, dest, weekendPattern) route, and two users watching the same route
// only cost one Duffel search per scan.
model PriceSnapshot {
  id             String   @id @default(cuid())
  originIata     String
  destIata       String
  departDate     String // "YYYY-MM-DD"
  returnDate     String // "YYYY-MM-DD"
  weekendPattern String
  priceUsd       Float
  currency       String   @default("USD")
  checkedAt      DateTime @default(now())

  @@index([originIata, destIata, weekendPattern, checkedAt])
  @@index([originIata, destIata, departDate, returnDate, checkedAt])
}

// One row per alert actually delivered, per channel. Drives dedup.
model NotificationLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originIata  String
  destIata    String
  departDate  String
  returnDate  String
  triggerType String // "BUDGET" | "PRICE_DROP"
  channel     String   @default("EMAIL") // "EMAIL" | "SMS"
  priceUsd    Float
  sentAt      DateTime @default(now())

  @@index([userId, originIata, destIata, departDate, returnDate, triggerType, channel, sentAt])
}
