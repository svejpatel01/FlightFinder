# Copy to .env and fill in.

DATABASE_URL="file:./dev.db"

# Public base URL — used to build magic-link and dashboard URLs.
APP_URL="http://localhost:3000"

# The one email address that is auto-added to the invite allowlist on startup.
OWNER_EMAIL="you@example.com"

# Session lifetime (days)
SESSION_TTL_DAYS="30"

# Duffel — https://duffel.com (free self-serve account).
# Token needs the 'air.offer_requests.create' permission (write access).
DUFFEL_API_KEY_TEST="duffel_test_xxx"
DUFFEL_API_KEY_LIVE="duffel_live_xxx"
DUFFEL_ENV="test"            # "test" | "live"
DUFFEL_MIN_INTERVAL_MS="1100"
DUFFEL_MOCK=""               # set to "1" to use deterministic fake prices

# Resend — https://resend.com (also sends the magic-link email)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="FlightFinder <onboarding@resend.dev>"

# Twilio — https://twilio.com  (SMS alerts for big price drops)
# US SMS requires A2P 10DLC registration on the Twilio side.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""        # E.164, e.g. +14155551234
SMS_MOCK="1"                 # "1" = log instead of sending (until Twilio is set up)
SMS_DROP_THRESHOLD="0.40"    # SMS fires on price drops >= this fraction below average

# Scan scheduler (scripts/cron.ts)
SCAN_CRON="0 */6 * * *"      # every 6 hours
